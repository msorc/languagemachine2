  0 = \f\x x;
  1 = \f\x f x;
  2 = \f\x f(f x);
  3 = \f\x f(f(f x));
  4 = \f\x f(f(f(f x)));
  5 = \f\x f(f(f(f(f x))));

  true   = \x\y x;
  false  = \x\y y;
  
  t = \x\y x;
  f = \x\y y;
  
  iszero = \n n (\y false) true;

  succ   = \n \f \x  f (n f x);
  pred   = \n \f \x  n (\g \h h (g f)) (\u x) (\u u);
  
  if     = \p\x\y  p x y;  
  
  plus   = \m \n \f \x  m f (n f x);
  mult   = \m \n        m (plus n) 0;
  
  yfunc  = \g     (\x  g(x x)) (\x  g(x x));
  
  factf  = \f \n  if (iszero n) 1 (mult n (f (pred n)));
  fact   = \n     yfunc (\f\n if (iszero n) 1 (mult n (f (pred n)))) n;
  factx  = \n     yfunc factf n;
  
  factr  = \n     if (iszero n) 1 (mult n (factr (pred n)));
  
  factr  4 t z;
