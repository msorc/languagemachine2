    '\\\\'         <- e1 [^\']: "\\\\";
    '\\\''         <- e1 [^\']: "\\\'";
    '\\\"'         <- e1 [^\']: "\\\"";

    '\\a'          <- e2 [^\"]: "\\a" ;
