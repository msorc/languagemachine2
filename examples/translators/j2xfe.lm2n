"delete"    <- "r?" :{ symbol :"j_delete" };
"export"    <- "r?" :{ symbol :"j_export" };
"function"  <- "r?" :{ symbol :"j_function" };
"is"        <- "r?" :{ symbol :"j_is" };
"in"        <- "r?" :{ symbol :"j_in" };
"instance"  <- "r?" :{ symbol :"j_instance" };
"module"    <- "r?" :{ symbol :"j_module" };
"out"       <- "r?" :{ symbol :"j_out" };
"override"  <- "r?" :{ symbol :"j_override" };
"template"  <- "r?" :{ symbol :"j_template" };
"union"     <- "r?" :{ symbol :"j_union" };
"version"   <- "r?" :{ symbol :"j_version" };
    
    
    "boolean"   <- "r?" :"boolean";

    "byte"      <- "r?" :"byte";
